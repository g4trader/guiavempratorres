# Next.js application; use the canonical domain in production
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public Supabase settings; data access remains protected by RLS
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# CLI protection; export in the shell before pnpm db:check
SUPABASE_PROJECT_REF=
SUPABASE_PROJECT_NAME=guiavempratorres
SUPABASE_ORGANIZATION_ID=ljfsuuapozqveecvqwxy

# Server-only Google Maps reverse geocoding
GOOGLE_MAPS_API_KEY=

# Authenticated E2E writes require a separate authorized cloud test project
# CLI/test tools do not automatically load this file; export only when needed
E2E_ALLOW_WRITES=false
E2E_SUPABASE_PROJECT_REF=
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
